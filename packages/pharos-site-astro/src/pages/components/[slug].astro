---
/**
 * Renders every page in the `components` collection at `/components/<slug>`.
 *
 * `components={mdxComponents}` is required: MDX honours a file's own
 * `export const components` only when that file is itself a route, so through
 * `<Content />` it is ignored and every `##` silently falls back to an `<h2>`.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import MarkdownLayout from '@layouts/MarkdownLayout.astro';
import { mdxComponents } from '@components/markdown/mdxComponents';

export const getStaticPaths = (async () => {
  const pages = await getCollection('components');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
---

<MarkdownLayout frontmatter={page.data}>
  <Content components={mdxComponents} />
</MarkdownLayout>
