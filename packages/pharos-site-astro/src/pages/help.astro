---
/** Ported from the Gatsby site's src/pages/help.tsx. */
import Layout from '@layouts/Layout.astro';
---

<Layout title="Help">
  <site-pharos-heading level="1" preset="7--bold">Help</site-pharos-heading>

  <site-pharos-heading level="2" preset="5">GitHub</site-pharos-heading>

  <p>
    Code for all our components, styles, tokens, assets, documentation, and this site lives in our <site-pharos-link
      href="https://github.com/ithaka/pharos"
      target="_blank">Pharos repository</site-pharos-link
    >.
  </p>
  <p>
    <site-pharos-button
      variant="secondary"
      icon-right="link-external"
      href="https://github.com/ithaka/pharos"
      target="_blank"
    >
      Go to GitHub
    </site-pharos-button>
  </p>

  <site-pharos-heading level="2" preset="5">Report an issue</site-pharos-heading>

  <p>
    If you find an issue with this site or a Pharos component, you can bring it to the maintainers'
    attention by creating a <site-pharos-link
      href="https://github.com/ithaka/pharos/issues"
      target="_blank">Github issue</site-pharos-link
    > in the Pharos repository.
  </p>
</Layout>
