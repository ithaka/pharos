---
import Layout from '@layouts/Layout.astro';
import PageSection from '@components/PageSection.astro';
import TokenTable from '@components/TokenTable.astro';
import TokenRows from '@components/TokenRows.astro';
import tokens from '@ithaka/pharos/lib/styles/tokens';
import type { DesignToken } from '@lib/tokenFormat';

const weights = Object.values(tokens.font.weight as Record<string, DesignToken>);

const rows = weights.map((token) => {
  const style = `font-weight: ${token.value}; line-height: normal;`;
  return {
    name: token.name,
    value: token.value,
    examples: [
      `<div style="${style}">ABCDEFGHIJKLMNOPQRSTUVWXYZ</div><div style="${style}">abcdefghijklmnopqrstuvwxyz</div>`,
    ],
  };
});
---

<Layout title="Font weight">
  <PageSection title="Font weight" isHeader>
    <TokenTable>
      <TokenRows rows={rows} />
    </TokenTable>
  </PageSection>
</Layout>
