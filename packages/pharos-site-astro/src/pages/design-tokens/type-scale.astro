---
/** Ported from the Gatsby site's src/pages/design-tokens/type-scale.tsx. */
import Layout from '@layouts/Layout.astro';
import PageSection from '@components/PageSection.astro';
import TokenTable from '@components/TokenTable.astro';
import tokens from '@ithaka/pharos/lib/styles/tokens';
import { toTokenName } from '@lib/tokenFormat';
import type { DesignToken } from '@lib/tokenFormat';

interface ScaleToken extends DesignToken {
  comment: string;
}

const scale = Object.values(tokens.type.scale as unknown as Record<string, ScaleToken>);
---

<Layout title="Type scale">
  <PageSection title="Type scale" isHeader>
    <TokenTable>
      <thead>
        <tr>
          <th style="width: 25%;">Token</th>
          <th style="width: 20%;">Value</th>
          <th style="width: 25%;">Sans-Serif</th>
          <th>Serif</th>
        </tr>
      </thead>
      <tbody>
        {
          scale.map((token) => (
            <tr>
              <td>
                <code class="token-code">{toTokenName(token.name)}</code>
              </td>
              <td>
                {token.comment} | {Number(token.comment.substring(0, token.comment.length - 2)) / 16}rem
              </td>
              <td>
                {Number(token.value) < 10 ? (
                  <span class="token-type-sans-serif" style={`font-size: ${token.comment};`}>
                    GT America
                  </span>
                ) : (
                  <site-pharos-icon name="dash-small" a11y-hidden="true" />
                )}
              </td>
              <td>
                {Number(token.value) > 5 ? (
                  <span
                    class="token-type-serif"
                    style={`font-size: ${token.comment}; font-family: var(--pharos-font-family-serif); line-height: var(--pharos-line-height-heading-large);`}
                  >
                    Ivar Headline
                  </span>
                ) : (
                  <site-pharos-icon name="dash-small" a11y-hidden="true" />
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </TokenTable>
  </PageSection>
</Layout>
