---
/** Ported from the Gatsby site's src/components/statics/PageSection.tsx. */
import ComponentExample from '@components/ComponentExample.astro';

/*
 * The Gatsby component also took `subSectionLevel`, `lessMargin` and
 * `topMargin` to render nested sub-sections. Converting the prose pages to
 * MDX moved that job to `markdown/Heading.astro`, which maps `###`/`####`/
 * `#####` itself, and no call site passes any of the three any more. They are
 * dropped here along with the `isHeader`/`subSectionLevel` conflict check,
 * which guarded a combination that can no longer occur. `Heading.astro`
 * documents the level/preset mapping they used.
 */
interface Props {
  title: string;
  description?: string;
  isHeader?: boolean;
  moreTitleSpace?: boolean;
  storyBookType?: string;
}

const {
  title,
  description,
  isHeader = false,
  moreTitleSpace = false,
  storyBookType,
} = Astro.props;

const heading = isHeader ? { level: '1', preset: '7--bold' } : { level: '2', preset: '6' };

const titleClass = isHeader
  ? 'section__title--is-header'
  : moreTitleSpace
    ? 'section__title--more-space'
    : undefined;

const descriptionClass = isHeader ? 'section__description--is-header' : 'section__description';
---

<div class="section">
  <div class={titleClass}>
    <site-pharos-heading level={heading.level} preset={heading.preset}>
      {title}
    </site-pharos-heading>
  </div>
  {
    /*
     * The Gatsby prop accepted a string or JSX. Plain text comes through the
     * `description` prop; richer markup (links, inline code) uses the
     * `description` slot instead.
     */
    (description || Astro.slots.has('description')) && (
      <div class={descriptionClass}>
        {description}
        <slot name="description" />
      </div>
    )
  }
  {
    storyBookType ? (
      <ComponentExample storyBookType={storyBookType} componentTitle={title}>
        <slot />
      </ComponentExample>
    ) : (
      <slot />
    )
  }
</div>
