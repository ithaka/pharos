---
/**
 * Renders the `thead` and `tbody` shared by the seven design-token tables.
 */
import { toTokenName } from '@lib/tokenFormat';

export interface TokenRow {
  /** Token name, rendered through `toTokenName` into the first cell. */
  name: string;
  /** Second-cell content as HTML. */
  value: string;
  /** Remaining cells as HTML, one entry per example column. */
  examples: string[];
}

interface Props {
  rows: TokenRow[];
  /** Header labels after `Token` and `Value`. */
  exampleHeadings?: string[];
  /** Inline `width` for each column, in order. Empty string means unset. */
  columnWidths?: string[];
}

const { rows, exampleHeadings = ['Example'], columnWidths = ['40%', '30%'] } = Astro.props;

const headings = ['Token', 'Value', ...exampleHeadings];
---

<thead>
  <tr>
    {
      headings.map((heading, i) => {
        const width = columnWidths[i];
        return width ? <th style={`width: ${width};`}>{heading}</th> : <th>{heading}</th>;
      })
    }
  </tr>
</thead>
<tbody>
  {
    rows.map((row) => (
      <tr>
        <td>
          <code class="token-code">{toTokenName(row.name)}</code>
        </td>
        <td set:html={row.value} />
        {row.examples.map((example) => (
          <td set:html={example} />
        ))}
      </tr>
    ))
  }
</tbody>
