---
/**
 * Guidance goes in the `do` and `dont` slots:
 *
 *   <BestPractices>
 *     <Fragment slot="do">Ebooks preserved in Portico</Fragment>
 *     <Fragment slot="dont">Portico preserves e-Books</Fragment>
 *   </BestPractices>
 *
 * Slot content is Markdown, so a list is written with `-` bullets rather than
 * `<ul><li>`.
 *
 * Line breaks inside a slot do not matter. MDX wraps a tag whose children span
 * several lines in a generated `<p>`, which would otherwise add a 24px margin
 * the single-line form does not have — so whether an author wrapped the text
 * would change the rendering. `.best-practices__guideline > p:only-child` in
 * `components.css` zeroes that margin, making the two forms render identically.
 *
 * Either side may be omitted; the column is then left out entirely, which is
 * how pages show a "do" with no matching "don't".
 */
import Grid from '@components/Grid.astro';
import BestPracticesColumn from '@components/BestPracticesColumn.astro';

const hasDo = Astro.slots.has('do');
const hasDont = Astro.slots.has('dont');
---

<Grid columns={2} hSpace={3} bottom={2}>
  <div>
    {
      hasDo && (
        <BestPracticesColumn variant="do">
          <slot name="do" />
        </BestPracticesColumn>
      )
    }
  </div>
  <div>
    {
      hasDont && (
        <BestPracticesColumn variant="dont">
          <slot name="dont" />
        </BestPracticesColumn>
      )
    }
  </div>
</Grid>
