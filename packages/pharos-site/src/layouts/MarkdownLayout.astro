---
/** Layout for MDX docs pages, mapping their frontmatter onto `Layout`'s props. */
import Layout from '@layouts/Layout.astro';
import Heading from '@components/markdown/Heading.astro';

import '../styles/markdown.css';

interface Props {
  frontmatter: {
    title: string; //Feeds both the `<title>` tag and the page's `<h1>`
    description?: string; //The standfirst, and the meta description.
    bodyClass?: string; //Opt-in hook for per-page styles, as `index.astro` uses.
  };
}

const { frontmatter } = Astro.props;
const { title, description, bodyClass } = frontmatter;
---

<Layout title={title} description={description} bodyClass={bodyClass}>
  <Heading depth={1}>{title}</Heading>
  {description && <div class="md-lede">{description}</div>}
  <div class="md-body">
    <slot />
  </div>
</Layout>
